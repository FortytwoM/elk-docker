ELASTIC_VERSION=9.5.3

# External IP or hostname of the Docker host (for Fleet agent enrollment).
# Agents on other machines use this to reach Fleet Server and Elasticsearch.
# Leave empty for local-only deployment (default: Docker internal names).
#FLEET_EXTERNAL_HOST=192.168.1.100

# Host port mappings. Use 127.0.0.1:PORT to bind localhost-only.
# Elasticsearch 9200 must be reachable by Elastic Agents (they ship data to ES, not Fleet Server).
ES_PORT=9200
KIBANA_PORT=5601
FLEET_PORT=8220
LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_PORT=50000

# JVM heaps. SIEM / detection rules / Elastic Defend: 2g heap, 6g container.
# Container mem_limit must stay above the heap (roughly 2× for Elasticsearch).
ES_JAVA_OPTS=-Xms2g -Xmx2g
LS_JAVA_OPTS=-Xms256m -Xmx256m
ES_MEM_LIMIT=6g
KIBANA_MEM_LIMIT=2g
LS_MEM_LIMIT=768m
FLEET_MEM_LIMIT=1g
REGISTRY_MEM_LIMIT=1g
ARTIFACTS_MEM_LIMIT=64m

# Artifact mirror (nginx). Agents use this instead of artifacts.elastic.co
# (binaries) and artifacts.security.elastic.co (Defend models).
# Same host as FLEET_EXTERNAL_HOST when set. Docker host needs outbound HTTPS.
ARTIFACTS_PORT=9080
ARTIFACTS_MEM_LIMIT=128m

# Delete logs-* / metrics-* backing indices this many days after creation.
# Rollover is daily (or at 10 GB). Set 0 to keep Elastic's default ILM (no delete).
RETENTION_DAYS=7

# Passwords — change before first run
ELASTIC_PASSWORD=changeme
LOGSTASH_INTERNAL_PASSWORD=changeme
KIBANA_SYSTEM_PASSWORD=changeme

# Beats users (leave empty if not using Beats extensions)
METRICBEAT_INTERNAL_PASSWORD=
FILEBEAT_INTERNAL_PASSWORD=
HEARTBEAT_INTERNAL_PASSWORD=
MONITORING_INTERNAL_PASSWORD=
BEATS_SYSTEM_PASSWORD=
